# development | staging | production
DJANGO_ENV=development    

# Django
# Required in production; uses an insecure default in dev
# DJANGO_SECRET_KEY=your-secret-key-here       
# Comma-separated; defaults to localhost   
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        

# PostgreSQL
POSTGRES_DB=cooffy
POSTGRES_USER=cooffy-postgres
POSTGRES_PASSWORD=cooffy-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS (only used when DJANGO_ENV != development)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000