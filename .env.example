# development | staging | production
DJANGO_ENV=development    

# Django
# Required in production; uses an insecure default in dev
# DJANGO_SECRET_KEY=your-secret-key-here       
# Comma-separated; defaults to localhost   
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        
# Comma-separated origins used for CSRF when behind the public domain
# CSRF_TRUSTED_ORIGINS=https://cooffy.example.com

# PostgreSQL
POSTGRES_DB=cooffy
POSTGRES_USER=cooffy-postgres
POSTGRES_PASSWORD=cooffy-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend
# Public origin baked into the production image at build time
# (docker/docker-compose.prod.yml passes it as a build arg). In production with
# nginx serving the app on a single origin, use that origin (e.g. https://cooffy.example.com).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production stack (docker/docker-compose.prod.yml)
# Host port where nginx is published; defaults to 80
# NGINX_PORT=80

# CORS (only used when DJANGO_ENV != development)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000