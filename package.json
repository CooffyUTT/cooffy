{
    "scripts": {
        "bru:auth": "cross-env-shell \"cd bruno/collections/Auth && bru run\"",
        "front": "pnpm --dir frontend dev",
        "front:lint": "pnpm --dir frontend lint",
        "front:test": "pnpm --dir frontend test",
        "front:test:watch": "pnpm --dir frontend test:watch",
        "front:typecheck": "pnpm --dir frontend typecheck",
        "front:install": "pnpm --dir frontend install",
        "back:uv": "uv --directory backend",
        "back": "pnpm back:uv run python -u manage.py runserver",
        "back:manage": "pnpm back:uv run python -u manage.py",
        "back:test": "pnpm back:manage test --noinput",
        "back:install": "pnpm back:uv sync",
        "back:lock": "pnpm back:uv lock",
        "dev": "concurrently -n back,front \"pnpm back\" \"pnpm front\"",
        "install:all": "cross-env-shell \"pnpm install && pnpm front:install && pnpm back:install\"",
        "init:all": "cross-env-shell \"pnpm install:all && docker compose up -d && pnpm back:manage migrate && pnpm back:manage seed && pnpm dev\""
    },
    "devDependencies": {
        "@usebruno/cli": "^3.5.2",
        "concurrently": "^10.0.3",
        "cross-env": "^7.0.3"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
